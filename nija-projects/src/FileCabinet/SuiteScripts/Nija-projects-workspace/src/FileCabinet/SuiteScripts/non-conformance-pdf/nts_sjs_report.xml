<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE pdf PUBLIC "-//big.faceless.org//report" "report-1.1.dtd">
<pdf xmlns:pdf="http://big.faceless.org/pdf" version="1.1">
<head>
<link name="NotoSans" type="font" subtype="truetype"
      src="NetSuiteFonts/NotoSans-Regular.ttf"
      src-bold="NetSuiteFonts/NotoSans-Bold.ttf"
      src-italic="NetSuiteFonts/NotoSans-Italic.ttf"
      src-bolditalic="NetSuiteFonts/NotoSans-BoldItalic.ttf"
      bytes="2"/>
    <macrolist>
        <macro id="nlheader">
            <table class="border" style="border-bottom:1pt solid black;">
                <tr>
                    <td class="border" width="20%" align="center" rowspan="2">
                        <img src="https://12075805.app.netsuite.com/core/media/media.nl?id=1339&amp;c=12075805&amp;h=NnP30L6CZd52s7O5z2K8la0V3C3p3hj9lENrB2a0j8TTqrQG" style="width:120px;height:90px;" />
                    </td>
                    <td class="border center" align="center">
                        <p class="title" align="center">SJS Enersol Engineering Works LLC</p>
                    </td>
                </tr>
                <tr>
                    <td class="border center" align="center">
                        <p class="sub-title" align="center">Non-Conformance Report</p>
                    </td>
                </tr>
            </table>
        </macro>
        <macro id="nlfooter">
            <p align="center" style="font-size: 9pt; padding-top: 10px;">Doc Ref No: ${record.name!}, Issue Date: ${record.custrecord_njt_non_confor!}</p>
            <p align="center" style="font-size: 9pt;">Page <pagenumber/> of <totalpages/></p>
        </macro>
    </macrolist>
    <style>
        body { font-family: NotoSans; font-size: 9pt; }
        p { margin: 0; padding: 0; }

        .title {
            font-size: 20pt;
            font-weight: bold;
            text-align: center;
            
        }

        .sub-title {
            font-size: 15pt;
            text-align: center;
            font-weight: bold;
            
        }

        .border { border: 0.5pt solid black; border-bottom:none;}
        .center { text-align: center; }
        .left { text-align: left; }
        .bold { font-weight: bold; }
        .custom-checkbox {
        width: 12px;
        height: 12px;
        margin: 0;
        vertical-align: middle;
  }
 .checkbox {
    cursor: pointer;
  }
.check div, .voucher1 div, .voucher2 div {
            position: relative;
            overflow: hidden;
            font-size: 8pt;
            font-family: Helvetica;
            padding: 0;
        }
        .check {
            top: -11pt;
            height: 250pt;
            width: 612pt;
        }

        table { width: 100%; border-collapse: collapse; margin-top: -0.5pt; }
        td { padding: 8px; }
        
        .inline-table { width: auto; margin: 0; padding: 0; }
        .inline-table td { padding: 0; border: none; vertical-align: middle; }
        .center .inline-table { margin: 0 auto; }
    </style>
</head>

<body header="nlheader" header-height="85pt" footer="nlfooter" footer-height="40pt" size="A4">

<!-- NCR + DATE -->
<table>
    <tr>
        <td class="bold" width="15%" align="right" style="padding-right: 6px;">NCR Nr.</td>
        <td width="35%" style="border-bottom: none;">${record.name!}</td>
        <td class="bold" width="15%" align="right" style="padding-right: 6px;">Date:</td>
        <td width="35%" style="border-bottom: none;">${record.custrecord_njt_non_confor!}</td>
    </tr>
</table>

<!-- TYPE -->
<table class="border">
    <tr>
        <td class="border center" width="33%">
            <table class="inline-table"><tr><td>Internal NCR:&nbsp;</td><td><#if (record.custrecord_njt_non_con_type_of_ncr!"")?string == "Internal NCR"><input name="chk_internal" class="custom-checkbox" type="checkbox" checked="checked" readonly="readonly" /><#else><input name="chk_internal" class="custom-checkbox" type="checkbox" readonly="readonly" /></#if></td></tr></table>
        </td>
        <td class="border center" width="34%">
            <table class="inline-table"><tr><td>Supplier NCR:&nbsp;</td><td><#if (record.custrecord_njt_non_con_type_of_ncr!"")?string == "Supplier NCR"><input name="chk_supplier" class="custom-checkbox" type="checkbox" checked="checked" readonly="readonly" /><#else><input name="chk_supplier" class="custom-checkbox" type="checkbox" readonly="readonly" /></#if></td></tr></table>
        </td>
        <td class="border center" width="33%">
            <table class="inline-table"><tr><td>Customer NCR:&nbsp;</td><td><#if (record.custrecord_njt_non_con_type_of_ncr!"")?string == "Customer NCR"><input name="chk_customer" class="custom-checkbox" type="checkbox" checked="checked" readonly="readonly" /><#else><input name="chk_customer" class="custom-checkbox" type="checkbox" readonly="readonly" /></#if></td></tr></table>
        </td>
    </tr>
</table>

<!-- DETAILS -->
<table class="border">
    <tr>
        <td class="border" width="50%">Name: ${record.custrecord_njt_non_con_name!}</td>
        <td class="border" width="50%">Vendor/Supplier: ${record.custrecord_njt_non_con_vendor!}</td>
    </tr>
    <tr>
        <td class="border">Position: ${record.custrecord_njt_non_con_position!}</td>
        <td class="border">Customer: ${record.custrecord_njt_non_con_customer!}</td>
    </tr>
    <tr>
        <td class="border">Part Number/Drawing Number: ${record.custrecord_njt_non_con_part_number!}</td>
        <td class="border">Contract/Purchase Order Ref: ${record.custrecord_njt_non_con_por!}</td>
    </tr>
</table>

<!-- QTY -->
<table class="border">
    <tr>
        <td class="border" width="50%">Total order Qty: ${record.custrecord_njt_non_con_toqty!}</td>
        <td class="border" width="50%">Rejected: ${record.custrecord_njt_non_con_rejected!}</td>
    </tr>
</table>

<!-- REPORT TYPE -->
<table class="border">
    <tr>
        <td class="border bold" colspan="2">Report Type (tick one box):</td>
    </tr>
    <tr>
        <td class="border" width="50%">
            <table class="inline-table"><tr><td>Non-Conformance/Corrective Action:&nbsp;</td><td><#if record.custrecord_njt_non_con_correct_action!false><input name="chk_corrective" class="custom-checkbox" type="checkbox" checked="checked" readonly="readonly" /><#else><input name="chk_corrective" class="custom-checkbox" type="checkbox" readonly="readonly" /></#if></td></tr></table>
        </td>
        <td class="border" width="50%">
            <table class="inline-table"><tr><td>Opportunity for Improvement/Preventative Action:&nbsp;</td><td><#if record.custrecord_njt_non_con_improvement_pre!false><input name="chk_preventative" class="custom-checkbox" type="checkbox" checked="checked" readonly="readonly" /><#else><input name="chk_preventative" class="custom-checkbox" type="checkbox" readonly="readonly" /></#if></td></tr></table>
        </td>
    </tr>
</table>

<!-- ORIGIN -->
<table class="border">
    <tr>
        <td class="border bold" colspan="2">Report Origin (tick one box):</td>
    </tr>
    <tr>
        <td class="border" width="50%">
            <table class="inline-table"><tr><td>Vendor/Supplier Feedback:&nbsp;</td><td><#if record.custrecord_njt_non_con_vendor_fee!false><input name="chk_vendor" class="custom-checkbox" type="checkbox" checked="checked" readonly="readonly" /><#else><input name="chk_vendor" class="custom-checkbox" type="checkbox" readonly="readonly" /></#if></td></tr></table>
        </td>
        <td class="border" width="50%">
            <table class="inline-table"><tr><td>In-house Inspection:&nbsp;</td><td><#if record.custrecord_njt_non_con_inhouse!false><input name="chk_inhouse" class="custom-checkbox" type="checkbox" checked="checked" readonly="readonly" /><#else><input name="chk_inhouse" class="custom-checkbox" type="checkbox" readonly="readonly" /></#if></td></tr></table>
        </td>
    </tr>
    <tr>
        <td class="border">
            <table class="inline-table"><tr><td>Customer Feedback:&nbsp;</td><td><#if record.custrecord_njt_non_con_customer_feed!false><input name="chk_cust_feed" class="custom-checkbox" type="checkbox" checked="checked" readonly="readonly" /><#else><input name="chk_cust_feed" class="custom-checkbox" type="checkbox" readonly="readonly" /></#if></td></tr></table>
        </td>
        <td class="border">
            <table class="inline-table"><tr><td>Audit Finding:&nbsp;</td><td><#if record.custrecord_njt_non_con_audit_finding!false><input name="chk_audit" class="custom-checkbox" type="checkbox" checked="checked" readonly="readonly" /><#else><input name="chk_audit" class="custom-checkbox" type="checkbox" readonly="readonly" /></#if></td></tr></table>
        </td>
    </tr>
</table>

<!-- DESCRIPTION -->
<table class="border">
    <tr>
        <td class="border bold">Description of Non-Conformity:</td>
    </tr>
    <tr>
        <td class="border" style="min-height:250px;">${record.custrecord_njt_non_con_description_con!}</td>
    </tr>
</table>

<!-- SIGN -->
<table class="border" style="border-bottom:1pt solid black;">
    <tr>
        <td class="border" width="50%">Originators Signature: ${record.custrecord_njt_non_con_originsigp1!}</td>
        <td class="border" width="50%">Date: ${record.custrecord_njt_non_con_orip1date!}</td>
    </tr>
</table>

<!-- PAGE BREAK -->
<pbr/>

<!-- ================= PAGE 2 ================= -->

<table class="border">
    <tr>
        <td class="border center bold" align="center">
            MANAGER – PROPOSED ACTIONS (please complete)
        </td>
    </tr>
</table>

<table class="border">
    <tr>
        <td class="border bold">Root Cause of Problem:</td>
    </tr>
    <tr>
        <td class="border" height="100px">${record.custrecord_njt_non_con_root_problem!}</td>
    </tr>
</table>

<!-- SEVERITY -->
<table class="border">
    <tr>
        <td class="border bold" colspan="2">Non-Conformance Severity:</td>
    </tr>
    <tr>
        <td class="border" width="50%">
            <table class="inline-table"><tr><td>Cosmetic/Non-Critical:&nbsp;</td><td><#if record.custrecord_njt_non_con_cosmetic!false><input name="chk_cosmetic" class="custom-checkbox" type="checkbox" checked="checked" readonly="readonly" /><#else><input name="chk_cosmetic" class="custom-checkbox" type="checkbox" readonly="readonly" /></#if></td></tr></table>
        </td>
        <td class="border" width="50%">
            <table class="inline-table"><tr><td>Critical:&nbsp;</td><td><#if record.custrecord_njt_non_con_critical!false><input name="chk_critical" class="custom-checkbox" type="checkbox" checked="checked" readonly="readonly" /><#else><input name="chk_critical" class="custom-checkbox" type="checkbox" readonly="readonly" /></#if></td></tr></table>
        </td>
    </tr>
</table>

<!-- DISPOSITION -->
<table class="border">
    <tr>
        <td class="border bold" colspan="2">Disposition:</td>
    </tr>
    <tr>
        <td class="border" width="50%">
            <table class="inline-table"><tr><td>Use-as-is:&nbsp;</td><td><#if record.custrecord_njt_non_con_use_as_is!false><input name="chk_useasis" class="custom-checkbox" type="checkbox" checked="checked" readonly="readonly" /><#else><input name="chk_useasis" class="custom-checkbox" type="checkbox" readonly="readonly" /></#if></td></tr></table>
        </td>
        <td class="border" width="50%">
            <table class="inline-table"><tr><td>Rework:&nbsp;</td><td><#if record.custrecord_njt_non_con_rework!false><input name="chk_rework" class="custom-checkbox" type="checkbox" checked="checked" readonly="readonly" /><#else><input name="chk_rework" class="custom-checkbox" type="checkbox" readonly="readonly" /></#if></td></tr></table>
        </td>
    </tr>
    <tr>
        <td class="border">
            <table class="inline-table"><tr><td>Reject/Return to Supplier:&nbsp;</td><td><#if record.custrecord_njt_non_con_reject!false><input name="chk_reject" class="custom-checkbox" type="checkbox" checked="checked" readonly="readonly" /><#else><input name="chk_reject" class="custom-checkbox" type="checkbox" readonly="readonly" /></#if></td></tr></table>
        </td>
        <td class="border">
            <table class="inline-table"><tr><td>Scrap:&nbsp;</td><td><#if record.custrecord_njt_non_con_scrap!false><input name="chk_scrap" class="custom-checkbox" type="checkbox" checked="checked" readonly="readonly" /><#else><input name="chk_scrap" class="custom-checkbox" type="checkbox" readonly="readonly" /></#if></td></tr></table>
        </td>
    </tr>
</table>

<!-- ACTION -->
<table class="border">
    <tr>
        <td class="border bold">Proposed Correction/Corrective/Preventative Action:</td>
    </tr>
    <tr>
        <td class="border" height="100px">${record.custrecord_njt_non_con_propose_correct!}</td>
    </tr>
</table>

<table class="border" style="border-bottom:1pt solid black;">
    <tr>
        <td class="border" width="50%">Managers Signature: ${record.custrecord_njt_non_con_mansigp2!}</td>
        <td class="border" width="50%">Date: ${record.custrecord_njt_non_con_mngsigp2date!}</td>
    </tr>
</table>

<br/>

<!-- CLOSURE -->
<table class="border">
    <tr>
        <td class="border center bold" align="center">
            RESPONSIBLE MANAGER – CLOSURE OF NON-CONFORMITY
        </td>
    </tr>
</table>

<table class="border">
    <tr>
        <td class="border bold">Description of Action Taken:</td>
    </tr>
    <tr>
        <td class="border" height="100px">${record.custrecord_njt_non_con_des_action!}</td>
    </tr>
</table>

<table class="border" style="border-bottom:1pt solid black;">
    <tr>
        <td class="border" width="50%">Managers Signature: ${record.custrecord_njt_non_con_mngsigp2rm!}</td>
        <td class="border" width="50%">Date: ${record.custrecord_njt_non_con_mngsigp2daterm!}</td>
    </tr>
    <tr>
        <td class="border">Originators: ${record.custrecord_njt_non_con_rmori!}</td>
        <td class="border">Date: ${record.custrecord_njt_non_con_rmoridate!}</td>
    </tr>
    <tr>
        <td class="border">QA Signature: ${record.custrecord_njt_non_con_qasig!}</td>
        <td class="border">Date: ${record.custrecord_njt_non_con_qasigdate!}</td>
    </tr>
</table>

</body>
</pdf>