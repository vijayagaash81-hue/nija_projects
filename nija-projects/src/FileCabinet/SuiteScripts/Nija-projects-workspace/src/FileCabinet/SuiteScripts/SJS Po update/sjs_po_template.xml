<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE pdf PUBLIC "-//big.faceless.org//report" "report-1.1.dtd">
<pdf>
<head>

<style type="text/css">

    body{
        font-family: Helvetica, sans-serif;
        font-size: 9pt;
    }

    table{
        width:100%;
        border-collapse:collapse;
    }

    .no-border td{
        border:none;
    }

    .main-table{
        width:100%;
        border-collapse:collapse;
        border:0.5pt solid #000;
    }

    .main-table th{
        border:0.5pt solid #000;
        background-color:#f2f2f2;
        padding:4px 2px;
        font-size:9.5pt;
        font-weight:bold;
        text-align:center;
        white-space:nowrap;
    }

    .main-table td{
        border:0.5pt solid #000;
        padding:5px;
        font-size:9pt;
        align:left;
        text-align:left;
        vertical-align:top;
        word-wrap:break-word;
        overflow-wrap:break-word;
    }

    .label{
        font-weight:bold;
        font-size:9pt;
        white-space:nowrap;
    }

    .title, td.title, .no-border td.title{
        align:center;
        font-size:22pt;
        font-weight:bold;
        text-align:center;
        padding-top:-10px;
        padding-bottom:15px;
    }

    .section-title{
        font-size:11pt;
        font-weight:bold;
        padding-top:-50px;
    }

    .summary-table{
        width:35%;
        align:right;
        border-collapse:collapse;
        margin-top:5px;
        page-break-inside:avoid;
    }

    .summary-table td{
        border-bottom:0.5pt solid #000;
        padding:5px;
        font-size:10pt;
    }

    .terms{
        padding-top:-80px;
        font-size:8pt;
    }

    .signature-table td{
        border-top:0.5pt solid #000;
        text-align:center;
        align:center;
        font-weight:bold;
    }

</style>

<macrolist>

    <!-- WATERMARK -->
    <macro id="draft_watermark">
        <#if record.custbody_hris_sales_approval_status?has_content && (record.custbody_hris_sales_approval_status?string?lower_case == "pending approval" || record.custbody_hris_sales_approval_status?string == "1")>
            <p align="center" valign="middle" rotate="-45" style="font-size: 125pt; color: #e5e5e5; font-weight: bold; letter-spacing: 5px; opacity: 0.25;">DRAFT</p>
        </#if>
    </macro>

    <!-- HEADER -->
    <macro id="nlheader">

        <table class="no-border">

            <tr>
                <td align="center">

                    <#if record.subsidiary == "SJS Enersol LLC">

                        <img src="https://12075805.app.netsuite.com/core/media/media.nl?id=2609&amp;c=12075805&amp;h=O64SxlG4LsWpTQ7LCnBKMcYi6jP9FLl-CoauR7s9agUSaA-D"
                             style="width:740px;height:160px;padding-top:-60px;" />

                    <#else>

                        <img src="https://12075805.app.netsuite.com/core/media/media.nl?id=2619&amp;c=12075805&amp;h=lASWwe_0oZq1SqApNwf7Jqg-8vu504mSGH7thyIidSx1320v"
                             style="width:600px;height:90px; padding-top:-40px;padding-left:-20px;" />

                    </#if>

                </td>
            </tr>

        </table>

    </macro>

    <!-- FOOTER -->
    <macro id="nlfooter">
<!-- SIGNATURE -->

<!-- <table class="signature-table" style="padding-top:-20px;">

    <tr>

        <td>Prepared By</td>

        <td>Approved By</td>

        <td>Accounts</td>

        <td>Checked By</td>

    </tr>

</table> -->
        <#if record.subsidiary == "SJS Enersol LLC">
            

            <table class="no-border" style="width:100%;">

                <tr>
                    <td align="center">
                        <img src="https://12075805.app.netsuite.com/core/media/media.nl?id=2610&amp;c=12075805&amp;h=XRONrANM19yECUoemjt7hHesM43YYYJpoDKZiz3h5ZvaZA1P"
                             style="width:580px;height:55px;" />
                    </td>
                </tr>

            </table>

        <#else>

            <table class="no-border" style="width:100%;">

                <tr>

                    <td style="width:45%;">
                        <span style="font-size:9pt;font-weight:bold;color:#2e5190;">
                            Name and Mobile Number:
                        </span><br/>

                        <span style="font-size:9pt;font-weight:bold;color:#2e5190;">
                            Receiver's Signature: ___________________
                        </span>
                    </td>

                    <td style="width:25%;" align="center">

                        <img src="https://12075805.app.netsuite.com/core/media/media.nl?id=1342&amp;c=12075805&amp;h=4Vq24cWx1KqWiN1XiHtzzTYH7-sQ2imkhln23ZDCxBNi0hDM"
                             style="width:180px;height:35px;" />

                    </td>

                    <td style="width:30%;" align="right">

                        <span style="font-size:10pt;font-weight:bold;color:#2e5190;">
                            For SJS Enersol Engineering Works L.L.C.
                        </span>

                    </td>

                </tr>

            </table>

            <table class="no-border"
                   style="background-color:#2e5190;width:100%;margin-top:5px;">

                <tr>

                    <td align="center"
                        style="color:#ffffff;font-weight:bold;font-size:10pt;padding:4px;">

                        Hex Bolt, Stud Bolt, Anchor Bolt And Heavy Engineering Construction

                    </td>

                </tr>

            </table>

        </#if>
          <table class="no-border" style="width:100%; margin-top:5px;">
           <tr>
             <td align="center" style="font-size:8pt;">
               Page <pagenumber/> of <totalpages/>
             </td>
           </tr>
          </table>

    </macro>

</macrolist>

</head>

<body header="nlheader"
      header-height="90pt"
      footer="nlfooter"
      footer-height="45pt"
      padding="0.5in"
      background-macro="draft_watermark">

<#list record.item?chunk(10) as itemBatch>

<!-- TITLE -->

<table class="no-border">

    <tr>
        <td class="title" align="center" style="align:center;text-align:center;">
            Purchase Order
        </td>
    </tr>

</table>

<!-- TOP DETAILS -->

<table class="no-border" style="margin-top:10px;padding-top:-20px;table-layout:fixed;">

    <tr>

        <!-- LEFT -->

        <td style="width:55%;vertical-align:top;" align="left">

            <table class="no-border" style="width:100%;table-layout:fixed;">

                <tr>
                    <td class="label" style="width:40%;" align="left">Purchase Order No:</td>
                    <td style="width:60%;" align="left">${record.tranid}</td>
                </tr>

                <tr>
                    <td class="label" style="width:40%;" align="left">RFQ REF No:</td>
                    <td style="width:60%;" align="left">${record.custbody_njt_purc_qout!""}</td>
                </tr>

                <tr>
                    <td class="label" style="width:40%;" align="left">Delivery Point:</td>
                    <td style="width:60%;" align="left">${record.custbody_delivery_point!""}</td>
                </tr>

                <tr>
                    <td class="label" style="width:40%;" align="left">Delivery Location:</td>
                    <td style="width:60%;" align="left">${record.custbody_delivery_location!""}</td>
                </tr>

                <tr>
                    <td class="label" style="width:40%;" align="left">Delivery Date:</td>
                    <td style="width:60%;" align="left">${record.duedate!""}</td>
                </tr>

                <tr>
                    <td class="label" style="width:40%;" align="left">Request By:</td>
                    <td style="width:60%;" align="left">${(record.employee!"")?replace("^([A-Z0-9_-]+)\\s+", "", "r")}</td>
                </tr>

                <!-- <tr>
                    <td class="label" style="width:40%;" align="left">Store Person Name:</td>
                    <td style="width:60%;" align="left">${(record.custbody4!"")?replace("^([A-Z0-9_-]+)\\s+", "", "r")}</td>
                </tr>

                <tr>
                    <td class="label" style="width:40%;" align="left">Store Person Contact:</td>
                    <td style="width:60%;" align="left">${record.custbody4.phone!""}</td>
                </tr> -->

            </table>

        </td>

        <!-- RIGHT -->

        <td style="width:45%;vertical-align:top;" align="left">

            <table class="no-border" style="width:100%;table-layout:fixed;">

                <tr>
                    <td class="label" style="width:35%;" align="left">Date:</td>
                    <td style="width:65%;" align="left">${record.trandate}</td>
                </tr>

                <tr>
                    <td class="label" style="width:35%;" align="left">Payment Terms:</td>
                    <td style="width:65%;" align="left">${record.terms!""}</td>
                </tr>

                <tr>
                    <td class="label" style="width:35%;" align="left">Delivery Terms:</td>
                    <td style="width:65%;" align="left">${record.incoterm!""}</td>
                </tr>

                <tr>
                    <td class="label" style="width:35%;" align="left">Division:</td>
                    <td style="width:65%;" align="left">${record.class!""}</td>
                </tr>

                <!-- <tr>
                    <td class="label" style="width:35%;" align="left">Atten To:</td>
                    <td style="width:65%;" align="left"><p align="left" style="margin:0;padding:0;text-align:left;align:left;"><#if record.custbody6?has_content><#if record.custbody6?contains(":")>${(record.custbody6?split(":")[1]!"")?replace("^[0-9\\s\\-_]+", "", "r")?replace("\\s+", " ", "r")?trim}<#else>${(record.custbody6!"")?replace("^[0-9\\s\\-_]+", "", "r")?replace("\\s+", " ", "r")?trim}</#if></#if></p></td>
                </tr>

                <tr>
                    <td class="label" style="width:35%;" align="left">Contact Person:</td>
                    <td style="width:65%;" align="left"><p align="left" style="margin:0;padding:0;text-align:left;align:left;"><#if record.custbody6?has_content><#if record.custbody6?contains(":")>${(record.custbody6?split(":")[1]!"")?replace("^[0-9\\s\\-_]+", "", "r")?replace("\\s+", " ", "r")?trim}<#else>${(record.custbody6!"")?replace("^[0-9\\s\\-_]+", "", "r")?replace("\\s+", " ", "r")?trim}</#if></#if></p></td>
                </tr> -->
                <tr>
                    <td class="label" style="width:35%;" align="left">Store Person Name:</td>
                    <td style="width:65%;" align="left">${(record.custbody4!"")?replace("^([A-Z0-9_-]+)\\s+", "", "r")}</td>
                </tr>

                <tr>
                    <td class="label" style="width:35%;white-space:nowrap;font-size:8pt;" align="left">Store&#160;&#160;Person&#160;&#160;Contact:</td>
                    <td style="width:65%;" align="left">${record.custbody4.phone!""}</td>
                </tr>

            </table>

        </td>

    </tr>

</table>

<!-- ORDER BY / ORDER TO -->

<table class="no-border" style="margin-top:-20px;table-layout:fixed;">

    <tr>

        <!-- ORDER BY -->

        <td style="width:55%;vertical-align:top;font-size:8pt;" align="left">

            <span class="section-title">ORDER BY:</span><br/>

            <b style="font-size:8pt;">${record.subsidiary}</b><br/>

            <span style="font-size:8pt;">${(subsidiary.mainaddress_text!"")?replace(record.subsidiary, "")?replace("^(<br\\s*\\/?>\\s*)+", "", "r")?trim}</span><br/>

            <span style="font-size:8pt;"><b>VAT/TRN:</b> ${subsidiary.federalidnumber!""}</span>

        </td>

        <!-- ORDER TO -->

        <td style="width:45%;vertical-align:top;font-size:8pt;" align="left">

            <span class="section-title">ORDER TO:</span><br/>

            <b style="font-size:8pt;">${(record.entity!"")?replace("^([A-Z0-9_-]+)\\s+", "", "r")}</b><br/>

            <span style="font-size:8pt;">${(record.billaddress!"")?replace("^.*?(<br\\s*\\/?>)", "", "r")}</span><br/>

            <span style="font-size:8pt;"><b>VAT Number:</b> ${record.entity.vatregnumber!""}</span>

        </td>

    </tr>

</table>

<!-- ITEM TABLE -->

<table class="main-table" style="margin-top:20px; table-layout:fixed;">

    <thead>

        <tr>

            <th style="width:5%;">S.NO</th>
            <th style="width:28%;">Description</th>
            <th style="width:6%;">UOM</th>
            <th style="width:8%;">Quantity</th>
            <th style="width:9%;">Rate</th>
            <th style="width:11%;">Amount</th>
            <th style="width:9%;">Tax Rate</th>
            <th style="width:12%;">Tax Amount</th>
            <th style="width:12%;">Total</th>

        </tr>

    </thead>

    <tbody>

        <#list itemBatch as item>

        <tr valign="top">

            <td align="center" valign="top">${item_index + 1 + (itemBatch?index * 7)}</td>

            <td align="left" valign="top" style="font-size:7.5pt;"><#if item.custcol_njt_podesc?? && item.custcol_njt_podesc?has_content>${item.custcol_njt_podesc?replace("\\s+", " ", "r")?trim}<#elseif item.description?? && item.description?has_content>${item.description?replace("\\s+", " ", "r")?trim}<#else>${item.item?replace("\\s+", " ", "r")?trim}</#if></td>

            <td align="center" valign="top">${item.units!""}</td>

            <td align="right" valign="top">${item.quantity?string("0.00")}</td>

            <td align="right" valign="top">${item.rate?string(",##0.00")}</td>

            <td align="right" valign="top">${item.amount?string(",##0.00")}</td>

            <td align="center" valign="top">5%</td>

            <td align="right" valign="top">${item.tax1amt?string(",##0.00")}</td>

            <td align="right" valign="top">${item.grossamt?string(",##0.00")}</td>

        </tr>

        </#list>

        <#if itemBatch?size lt 10>

            <#list 1..(10-itemBatch?size) as x>

            <tr style="height:11pt;">

                <td style="height:11pt;"></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>

            </tr>

            </#list>

        </#if>

    </tbody>

</table>

<!-- TOTAL IN WORDS (SEPARATED) -->
<!-- TOTAL IN WORDS -->

<table class="main-table" style="margin-top:5px; table-layout:fixed; page-break-inside:avoid;">

    <tr>

        <!-- S.NO + Description + UOM + Quantity + Rate (5% + 28% + 6% + 8% + 8% = 55%) -->
        <td style="width:56%;">
            <b>AED</b> Total in Words:
            ${record.custbody_njt_tran_tiw!""}
        </td>

        <!-- AMOUNT label + value (11%) -->
        <td style="width:11%;" align="right">
            <b>Amount</b><br/>${record.subtotal?string(",##0.00")}
        </td>

        <!-- TAX RATE (9%) - empty spacer -->
        <td style="width:9%;"></td>

        <!-- TAX AMOUNT label + value (12%) -->
        <td style="width:12%;" align="right">
            <b>TAX Amount</b><br/>${record.taxtotal?string(",##0.00")}
        </td>

        <!-- TOTAL label + value (12%) -->
        <td style="width:12%;" align="right">
            <b>Total (AED)</b><br/>${record.total?string(",##0.00")}
        </td>

    </tr>

</table>

<!-- TERMS AND SUMMARY (last page only) -->
              
<#if !itemBatch?has_next>

<table class="summary-table" style="page-break-inside:avoid;">

    <tr>
        <td style="border:none;"><b>Amount</b></td>
        <td align="right" style="border:none;">${record.subtotal?string(",##0.00")}</td>
    </tr>

    <tr>
        <td><b>TAX Amount</b></td>
        <td align="right">${record.taxtotal?string(",##0.00")}</td>
    </tr>

    <tr>
        <td><b>Total (${record.currency})</b></td>
        <td align="right"><b>${record.total?string(",##0.00")}</b></td>
    </tr>

</table>

<div class="terms">

    <b>Terms and Conditions</b><br/>
    1.MTC Required upon delivery

    ${record.custbody5!""}

    <br/><br/>

    <b>Additional Notes</b><br/>

    <#if record.custbody_additional_notes?has_content>
        ${record.custbody_additional_notes}<br/>
    </#if>
    
    1. Above Purchase Order No Must Appear on all invoices or correspondence.<br/>
    2. Mail One Copy of Your Invoice.<br/>
    3. Our Standard Conditions of Purchase Apply.

</div>
</#if>
<#if itemBatch?has_next>
    <pbr/>
</#if>
</#list>

</body>
</pdf> 