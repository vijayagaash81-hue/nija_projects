<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE pdf PUBLIC "-//big.faceless.org//report" "report-1.1.dtd">
<pdf>
<head>
    <style type="text/css">
        /* General page font */
        body {
            font-family: "Times New Roman", serif;
            font-size: 11px;
        }
        /* Main Item Table */
        .item-table {
            width: 100%;
            border-collapse: collapse;
            border: 0.1pt solid #000000;
        }
        /* Remove horizontal borders between rows, keep vertical borders */
        .item-table th {
            border: 0.1pt solid #000000;
            padding: 3px 2px;
            font-size: 10px;
            background-color: #f2f2f2;
            font-weight: bold;
            white-space: nowrap;
        }
        .item-table td {
            border-left: 0.1pt solid #000000;
            border-right: 0.1pt solid #000000;
            border-top: none;
            border-bottom: none;
            padding: 2px 3px;
            font-size: 10px;
            line-height: 11.5px;
            white-space: normal;
            word-wrap: break-word;
        }
        /* Border for the very last row or total row */
        .total-row td {
            border-top: 0.1pt solid #000000;
            border-bottom: 0.1pt solid #000000;
            border-left: 0.1pt solid #000000;
            border-right: 0.1pt solid #000000;
            font-weight: bold;
            padding: 2.5px 3px;
            font-size: 10px;
        }
        /* Class to remove all borders for layout-only tables */
        .no-border, .no-border td {
            border: none;
        }
        /* Header table: no borders and centered for the logo */
        .header-table, .header-table td {
            border: none;
            padding: 0;
            text-align: center;
        }
        .right { text-align: right; }
        .center { text-align: center; }
        .bold { font-weight: bold; }

        /* Summary table: Outer border box remains, but internal row lines are removed */
        .summary-table {
            border: 0.5pt solid #000000; 
            border-collapse: collapse;
            white-space: nowrap;
            width: 100%;
        }
        .summary-table td {
            border: none; 
            padding: 2px 4px;
            font-size: 9.5px;
        }
    </style>
    <!-- HEADER AND FOOTER MACRO DEFINITIONS -->
    <macrolist>
        <macro id="nlheader">
            <table class="header-table">
                <tr>
                    <td align="center" style="vertical-align: middle;">
                         <#if record.subsidiary == "SJS Enersol LLC">
                            <img src="https://12075805.app.netsuite.com/core/media/media.nl?id=2609&amp;c=12075805&amp;h=O64SxlG4LsWpTQ7LCnBKMcYi6jP9FLl-CoauR7s9agUSaA-D" style="width: 740px; height: 160px; padding-top:-100px;" />
                        <#else>
                            <img src="https://12075805.app.netsuite.com/core/media/media.nl?id=1340&amp;c=12075805&amp;h=-mpjWB5fxJRaHmreQOolrSVc13CuK2Cz1T5y_xpOQFw6cWiJ" style="width: 740px; height: 100px;" />
                        </#if>
                    </td>
                </tr>
            </table>
        </macro>
        <macro id="nlfooter">
            <#if record.subsidiary == "SJS Enersol LLC">
                <table class="no-border" style="width: 100%;">
                    <tr>
                        <td style="width: 100%; text-align: center; vertical-align: top;">
                             <img src="https://12075805.app.netsuite.com/core/media/media.nl?id=2610&amp;c=12075805&amp;h=XRONrANM19yECUoemjt7hHesM43YYYJpoDKZiz3h5ZvaZA1P" style="width: 580px; height: 50px;"/>
                        </td>
                    </tr>
                </table>
            <#else>
                <table class="no-border" style="width: 100%;">
                    <tr>
                        <td style="width: 45%; vertical-align: bottom;">
                            <span style="color: #2e5190; font-weight: bold; font-size: 10px;">Name and Mobile Number:</span><br/>
                            <span style="color: #2e5190; font-weight: bold; font-size: 10px;">Receiver's Signature: ...........................................................</span>
                        </td>
                        <td style="width: 25%; text-align: center; vertical-align: top;">
                            <img src="https://12075805.app.netsuite.com/core/media/media.nl?id=1342&amp;c=12075805&amp;h=4Vq24cWx1KqWiN1XiHtzzTYH7-sQ2imkhln23ZDCxBNi0hDM" style="width: 160px; height: 30px;"/>
                        </td>
                        <td style="width: 30%; text-align: right; vertical-align: bottom;">
                            <span style="color: #2e5190; font-weight: bold; font-size: 11px;">For SJS Enersol Engineering Works L.L.C.</span>
                        </td>
                    </tr>
                </table>
               
                <table class="no-border" style="width: 100%; background-color: #2e5190; margin-top: 3px;">
                    <tr>
                        <td align="center" style="color: #ffffff; font-weight: bold; font-size: 10pt; padding: 3px;">
                            Hex Bolt, Stud Bolt, Anchor Bolt And Heavy Engineering Construction
                        </td>
                    </tr>
                </table>
            </#if>
        </macro>
    </macrolist>
</head>
<body header="nlheader" header-height="75pt" footer="nlfooter" footer-height="55pt">
<!-- PAGINATION LOGIC: 10 ITEMS PER PAGE -->
<#assign filteredItems = [] />
<#list record.item as item>
    <#if item.amount?has_content>
        <#if (item.amount > 0)>
            <#assign filteredItems = filteredItems + [item] />
        </#if>
    </#if>
</#list>
<#if filteredItems?size == 0>
    <#assign filteredItems = [ { "custcol_njt_podesc": "", "description": "", "units": "" } ] />
</#if>
<#list filteredItems?chunk(10) as itemBatch>
    <!-- DOCUMENT TITLE -->
    <table class="no-border" style="width: 100%; margin-top: 5px;">
      <tr>
        <td align="center">
          <span style="font-size:18px; font-family:Georgia,serif; font-weight:bold; border-bottom:2px solid #000; padding-bottom:2px;">
            Tax Proforma Invoice
          </span>
        </td>
      </tr>
    </table>
    
    <!-- CUSTOMER AND INVOICE CORE DETAILS WITH IMPROVED SPACING -->
    <table class="no-border" cellpadding="0" cellspacing="0" style="width: 100%; margin-top: 5px;">
        <tr>
            <!-- BILL TO SECTION -->
          <td style="width: 55%; vertical-align: top; font-size:11px;">
    <span style="font-weight: bold; font-size: 12px;">Customer Details:</span><br/>
    <span style="line-height: 14px;">
        <span style="font-size: 11px;">
            <#if record.entity.companyname?has_content>
                <strong>${record.entity.companyname}</strong><br/>
            <#elseif record.entity.firstname?has_content>
                <strong>${record.entity.firstname} ${record.entity.lastname}</strong><br/>
            <#else>
                <strong>${record.entity}</strong><br/>
            </#if>
        </span>
        <span style="font-size: 10px;">
            <#if customData?? && customData.addressInfo?? && customData.addressInfo.formattedAddress?has_content>
                ${customData.addressInfo.formattedAddress}
            <#else>
                ${record.billaddress?replace("<br />","<br/>")}
            </#if>
        </span>
    </span>
</td>
            <!-- SPACER COLUMN TO CREATE THE GAP -->
            <td style="width: 5%;"></td>
            <!-- LABELS SECTION -->
            <td style="width: 18%; font-size:10px; vertical-align: top;">
                <strong>DATE</strong><br/>
                <strong>P.I NO</strong><br/>
                <strong>CURRENCY</strong><br/>
                <strong>PAYMENT TERMS</strong><br/>
                <strong>LPO NO</strong><br/>
               <strong>SALES PERSON</strong>
            </td>
            <!-- VALUES SECTION -->
            <td style="width: 22%; font-size:10px; vertical-align: top;">
                : ${record.trandate}<br/>
                : ${record.tranid}<br/>
                : ${record.currency}<br/>
                : ${record.terms}<br/>
                : ${record.otherrefnum}<br/>
                <#if record.salesrep.firstname?has_content>
                    : ${record.salesrep.firstname} ${record.salesrep.lastname}<br/>
                <#else>
                    : ${record.salesrep}<br/>
                </#if>
            </td>
        </tr>
    </table>
    <!-- TEL AND TRN ROW -->
    <table class="no-border" cellpadding="0" cellspacing="0" style="margin-top: 5px; width: 100%;">
        <tr>
             <td style="width: 5%; font-size:10px;"><strong>TRN:</strong></td>   
            <td style="width: 20%; font-size:10px;">${record.vatregnum}</td>
        </tr>
        <tr>
            <td style="width: 5%; font-size:10px;"><strong>Tel:</strong></td> 
            <td style="width: 20%; font-size:10px;">${record.entity.phone}</td>
            <td style="width: 5%; font-size:10px;"><strong>Fax:</strong></td> 
            <td style="width: 20%; font-size:10px;">${record.entity.fax}</td>
        </tr>
    </table>
    
    <!-- MAIN ITEM TABLE -->
    <table class="item-table" cellspacing="0" style="margin-top: 5px;">
        <thead>
            <tr>
                <th align="center" style="width:5%;">S. NO</th>
                <th align="center" style="width:30%;">DESCRIPTION</th>
                <th align="center" style="width:8%;">UOM</th>
                <th align="center" style="width:10%;">QTY</th>
                <th align="center" style="width:12%;">RATE ${record.currency}</th>
                <th align="center" style="width:12%;">TOTAL ${record.currency}</th>
                <th align="center" style="width:10%;">5% VAT ${record.currency}</th>
                <th align="center" style="width:13%;">NET TOTAL ${record.currency}</th>
            </tr>
        </thead>
        <#list itemBatch as item>
        <tr>
            <td align="center"><#if item.quantity?has_content>${item_index + 1 + (itemBatch?index * 10)}</#if></td>
            <td align="left"><#if item.custcol_njt_podesc?has_content>${item.custcol_njt_podesc}<#else>${item.description}</#if></td>
            <td align="center">${item.units}</td>
            <td align="right"><#if item.quantity?has_content>${item.quantity?string("0.00")}</#if></td>
            <td align="right"><#if item.quantity?has_content>${item.rate?string("#,##0.00")}</#if></td>
            <td align="right"><#if item.quantity?has_content>${item.amount?string("#,##0.00")}</#if></td>
            <td align="right"><#if item.quantity?has_content>${item.tax1amt?string("#,##0.00")}</#if></td>
            <td align="right"><#if item.quantity?has_content>${item.grossamt?string("#,##0.00")}</#if></td>
        </tr>
        </#list>
        <#assign rowCount = itemBatch?size>
        <#assign maxRows = 10>
        <#if rowCount < maxRows>
            <#list 1..(maxRows - rowCount) as i>
                <tr>
                    <td>&nbsp;</td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                </tr>
            </#list>
        </#if>
        <#if !itemBatch?has_next>
        <!-- TOTAL LINE ONLY ON LAST PAGE -->
        <tr class="total-row">
            <td colspan="5" align="left">Total</td>
            <td align="right">${record.subtotal?string("#,##0.00")}</td>
            <td align="right">${record.taxtotal?string("#,##0.00")}</td>
            <td align="right">${record.total?string("#,##0.00")}</td>
        </tr>
        <#else>
        <!-- Bottom border for the table on intermediate pages -->
        <tr>
            <td colspan="8" style="border-top: 0.1pt solid black; height: 1px; padding: 0;"></td>
        </tr>
        </#if>
    </table>

    <!-- SUMMARY SECTION BELOW ITEM TABLE (AMOUNT IN WORDS, BANK DETAILS, STAMP & SUMMARY BOX) - REPEATED ON ALL PAGES -->
    <table class="no-border" cellpadding="0" cellspacing="0" style="width: 100%; margin-top: 5px;">
        <tr>
            <!-- LEFT COLUMN: AMOUNT IN WORDS & BANK DETAILS -->
            <td style="width: 52%; vertical-align: top; padding-right: 5px;">
                <!-- Amount in Words -->
                <div style="font-size: 10px; margin-bottom: 5px;">
                    <b>Amount in Words:</b><br/>
                    <b>${record.currency} </b>${customData.totalWords?upper_case} ONLY
                </div>
                <!-- Bank Details -->
                <div style="font-size: 9.5px; line-height: 13px;">
                    <#if record.subsidiary == "SJS Enersol LLC">
                        <strong>A/C Title:</strong> SJS Enersol LLC<br/>
                        <strong>A/C No:</strong> 100-234850-4<br/>
                        <strong>IBAN No:</strong> AE93 0230 0000 0100 2348 504<br/>
                        <strong>Bank Name:</strong> Commercial Bank of Dubai<br/>
                        <strong>Bank Swift Code:</strong> CBDUAEADXXX<br/>
                        <strong>A/C Currency:</strong> ${record.currency}
                    <#else>
                        <strong>A/C Title:</strong> SJS Enersol Engineering Works LLC<br/>
                        <strong>A/C No:</strong> 116-535379200-01<br/>
                        <strong>IBAN No:</strong> AE28 0030 0116 5353 7920 001<br/>
                        <strong>Bank Name:</strong> Abu Dhabi Commercial Bank<br/>
                        <strong>Bank Swift Code:</strong> ADCBAEAA<br/>
                        <strong>A/C Currency:</strong> ${record.currency}
                    </#if>
                </div>
            </td>

            <!-- CENTER COLUMN: STAMP -->
            <td style="width: 14%; text-align: center; vertical-align: top; padding-top: 5px;">
                <#if record.subsidiary == "SJS Enersol LLC">
                    <img src="https://12075805.app.netsuite.com/core/media/media.nl?id=2612&amp;c=12075805&amp;h=aSxLVjuxt-21ptRX30lX5_2a8i13hkkFj8WSvkLOb9dlYyGE" style="width: 95px; height: 65px;"/>
                <#else>
                    <img src="https://12075805.app.netsuite.com/core/media/media.nl?id=1341&amp;c=12075805&amp;h=p6n_1j8Du-e12Nvqgxvj2CNQf9B1_hxXyQ14-EmkGkEMEBwU" style="width: 85px; height: 85px;"/>
                </#if>
            </td>

            <!-- RIGHT COLUMN: SUMMARY TABLE BOX -->
            <#assign totalAmount = record.total!0>
            <#assign discountAmount = record.discounttotal!0>

            <#assign advanceClaim = 0>
            <#if record.custbody3?has_content>
                <#assign advanceClaimStr = record.custbody3?string?replace(",", "")>
                <#assign advanceClaim = advanceClaimStr?number>
            </#if>

            <#assign vatAmount = record.taxtotal!0>
            <#assign grossAmount = record.subtotal!0 - discountAmount - advanceClaim>
            <#assign netAmount = grossAmount + vatAmount>

            <td style="width: 34%; vertical-align: top;">
                <table class="summary-table" cellspacing="0" style="width: 100%;">
                    <tr>
                        <td style="font-weight:bold;">DISCOUNT AMOUNT</td>
                        <td align="right">${discountAmount?string("#,##0.00")}</td>
                    </tr>
                    <tr>
                       <td style="font-weight:bold;">ADVANCE RECEIVED</td>
                       <td align="right">(${advanceClaim?string("#,##0.00")})</td>
                    </tr>
                    <tr>
                        <td style="font-weight:bold;">GROSS AMOUNT</td>
                        <td align="right">${grossAmount?string("#,##0.00")}</td>
                    </tr>
                    <tr>
                        <td style="font-weight:bold;">VAT 5%</td>
                        <td align="right">${vatAmount?string("#,##0.00")}</td>
                    </tr>
                    <tr style="background-color: #f2f2f2; border-top: 0.5pt solid black;">
                        <td style="font-weight:bold;">NET AMOUNT</td>
                        <td align="right" style="font-weight:bold;">
                             ${netAmount?string("#,##0.00")}
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>

    <#if itemBatch?has_next>
        <!-- Page Break if there are more items -->
        <pbr />
    </#if>
</#list>
</body>
</pdf>