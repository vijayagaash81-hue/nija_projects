<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE pdf PUBLIC "-//big.faceless.org//report" "report-1.1.dtd">
<pdf>
<head>
    <style type="text/css">
        /* General page font */
        body {
            font-family: "Times New Roman", serif;
            font-size: 12px;
        }
        /* Main Item Table */
        .item-table {
            padding-top:-10px;
            width: 100%;
            border-collapse: collapse;
            border: 0.1pt solid #000000;
            margin-bottom: 0px;
        }
        /* Header styling */
        .item-table th {
            border: 0.1pt solid #000000;
            padding: 5px 4px;
            font-size: 12px;
            background-color: #f2f2f2;
            font-weight: bold;
            white-space: nowrap;
        }
        /* Data cell styling - Adjusted to ensure summary fits on page 1 */
        .item-table td {
            border-left: 0.1pt solid #000000;
            border-right: 0.1pt solid #000000;
            border-top: none;
            border-bottom: none;
            padding: 6px 4px; 
            font-size: 12px;
            
        }
        /* Border for the very last row or total row */
        .total-row td {
            border-top: 0.1pt solid #000000;
            border-left:none;
            font-weight: bold;
            height:20px;
            padding: 5px 4px;
        }
        /* Class to remove all borders for layout-only tables */
        .no-border, .no-border td {
            border: none;
        }
        /* Header table: no borders and centered for the logo */
        .header-table, .header-table td {
            border: none;
            padding: 0;
            text-align: center;
        }
        .right { text-align: right; }
        .center { text-align: center; }
        .bold { font-weight: bold; }

        /* Summary table styling */
        .summary-table {
            border: 0.5pt solid #000000; 
            border-collapse: collapse;
        }
        .summary-table td {
            border: none; 
            padding: 4px;
            font-size: 12px;
        }
    </style>
    <!-- HEADER AND FOOTER MACRO DEFINITIONS -->
    <macrolist>
        <macro id="nlheader">
            <table class="header-table">
                <tr>
                    <td align="center" style="vertical-align: middle;">
                        <#if record.subsidiary == "SJS Enersol LLC">
                            <img src="https://12075805.app.netsuite.com/core/media/media.nl?id=2609&amp;c=12075805&amp;h=O64SxlG4LsWpTQ7LCnBKMcYi6jP9FLl-CoauR7s9agUSaA-D" style="width: 740px; height: 160px;padding-top:-100px;" />
                        <#else>
                            <img src="https://12075805.app.netsuite.com/core/media/media.nl?id=2619&amp;c=12075805&amp;h=lASWwe_0oZq1SqApNwf7Jqg-8vu504mSGH7thyIidSx1320v" style="width:650px;height:90px; padding-top:-40px;padding-left:0px;" />
                        </#if>
                    </td>
                </tr>
            </table>
        </macro>
        <macro id="nlfooter">
            <#if record.subsidiary == "SJS Enersol LLC">
                <table class="no-border" style="width: 100%; margin-top: 10px;">
                    <tr>
                        <td style="width: 100%; text-align: center; vertical-align: top; padding-left:50px;padding-top:10px;">
                             <img src="https://12075805.app.netsuite.com/core/media/media.nl?id=2610&amp;c=12075805&amp;h=XRONrANM19yECUoemjt7hHesM43YYYJpoDKZiz3h5ZvaZA1P" style="width: 580px; height: 55px;"/>
                        </td>
                    </tr>
                </table>
            <#else>
                <table class="no-border" style="width: 100%; margin-top: 10px;">
                    <tr>
                        <td style="width: 45%; vertical-align: bottom;">
                            <span style="color: #2e5190; font-weight: bold; font-size: 11px;">Name and Mobile Number:</span><br/>
                            <span style="color: #2e5190; font-weight: bold; font-size: 11px;">Receiver's Signature: ...........................................................</span>
                        </td>
                        <td style="width: 25%; text-align: center; vertical-align: top;">
                            <img src="https://12075805.app.netsuite.com/core/media/media.nl?id=1342&amp;c=12075805&amp;h=4Vq24cWx1KqWiN1XiHtzzTYH7-sQ2imkhln23ZDCxBNi0hDM" style="width: 180px; height: 35px;"/>
                        </td>
                        <td style="width: 30%; text-align: right; vertical-align: bottom;">
                            <span style="color: #2e5190; font-weight: bold; font-size: 12px;">For SJS Enersol Engineering Works L.L.C.</span>
                        </td>
                    </tr>
                </table>
               
                <table class="no-border" style="width: 100%; background-color: #2e5190; margin-top: 5px;">
                    <tr>
                        <td align="center" style="color: #ffffff; font-weight: bold; font-size: 11pt; padding: 4px;">
                            Hex Bolt, Stud Bolt, Anchor Bolt And Heavy Engineering Construction
                        </td>
                    </tr>
                </table>
            </#if>
        </macro>
    </macrolist>
</head>
<body header="nlheader" header-height="80pt" footer="nlfooter" footer-height="70pt">

<!-- START ITEM COUNTER FOR SERIAL NUMBERS -->
<#assign sn = 1 />
<#assign batchIndex = 0 />

<!-- FILTER OUT ITEMS WHERE AMOUNT IS ZERO -->
<#assign filteredItems = [] />
<#list record.item as rawItem>
    <#if rawItem.amount?has_content && rawItem.amount != 0>
        <#assign filteredItems = filteredItems + [rawItem] />
    <#elseif !rawItem.amount?has_content>
        <#assign filteredItems = filteredItems + [rawItem] />
    </#if>
</#list>

<!-- PAGINATION LOGIC: 5 ITEMS PER PAGE -->
<#list filteredItems?chunk(5) as itemBatch>
    <!-- DOCUMENT TITLE -->
    <table class="no-border" style="width: 100%; margin-top: 10px;">
      <tr>
        <td align="center">
          <span style="font-size:22px; font-family:Georgia,serif; font-weight:bold; border-bottom:2px solid #000; padding-bottom:3px;">
            Tax Invoice
          </span>
        </td>
      </tr>
    </table>
    <br/>
    <!-- CUSTOMER AND INVOICE DETAILS -->
    <table class="no-border" cellpadding="0" cellspacing="0" style="width: 100%;">
        <tr>
          <td style="width: 55%; vertical-align: top; font-size:12px;">
            <span style="font-weight: bold; font-size: 13px;">Customer Details,</span><br/>
            <span style="line-height: 16px;">
                <#if record.entity.companyname?has_content>
    <strong style="display:block; width:280px; white-space:normal; word-break:break-word;">
        ${record.entity.companyname}
    </strong><br/>
<#elseif record.entity.firstname?has_content>
    <strong style="display:block; width:280px; white-space:normal; word-break:break-word;">
        ${record.entity.firstname} ${record.entity.lastname}
    </strong><br/>
<#else>
    <strong style="display:block; width:280px; white-space:normal; word-break:break-word;">
        ${record.entity}
    </strong><br/>
</#if>
                <#if customData?? && customData.addressInfo??>
                    <#if customData.addressInfo.addr1?has_content>${customData.addressInfo.addr1}<br/></#if>
                    <#assign line3 = "">
                    <#if customData.addressInfo.city?has_content><#assign line3 = line3 + customData.addressInfo.city></#if>
                    <#if customData.addressInfo.state?has_content><#if line3?has_content><#assign line3 = line3 + ", "></#if><#assign line3 = line3 + customData.addressInfo.state></#if>
                    <#if customData.addressInfo.zip?has_content><#if line3?has_content><#assign line3 = line3 + " "></#if><#assign line3 = line3 + customData.addressInfo.zip></#if>
                    <#if line3?has_content>${line3}<br/></#if>
                    <#if customData.addressInfo.country?has_content>${customData.addressInfo.country}</#if>
                </#if>
            </span>
          </td>
          <td style="width: 5%;"></td>
          <td style="width: 18%; font-size:12px; vertical-align: top;">
                <strong>Date</strong><br/>
                <strong>Invoice No</strong><br/>
                <strong>Payment Terms</strong><br/>
                <strong>Delivery Order No</strong><br/>
                <strong>Order No</strong><br/>
                <strong>Currency</strong>
          </td>
          <td style="width: 22%; font-size:12px; vertical-align: top;white-space:nowrap;">
                : ${record.trandate}<br/>
                : ${record.tranid}<br/>
                : ${record.terms}<br/>
                : <#if customData?? && customData.deliveryOrderNo??>${customData.deliveryOrderNo}</#if><br/>
                : ${record.otherrefnum}<br/>
                : ${record.currency}
          </td>
        </tr>
    </table>
    
    <table class="no-border" cellpadding="0" cellspacing="0"
       style="margin-top:15px; width:100%;">

    <!-- TRN ROW -->
    <tr>
        <td colspan="4"
            style="font-size:12px; text-align:left; padding-bottom:5px;">
            <strong>TRN:</strong> ${record.vatregnum}
        </td>
    </tr>

    <!-- TEL ROW -->
    <tr>
        <td style="width:4%; font-size:12px;">
            <strong>Tel:</strong>
        </td>

        <td style="width:35%; font-size:12px;">
            ${record.entity.phone}
        </td>

        <td style="width:5%;"></td>

        <td style="width:45%;"></td>
    </tr>

</table>
    <br/>

    <!-- MAIN ITEM TABLE -->
    <table class="item-table" cellspacing="0">
        <thead>
            <tr>
                <th align="center" style="width:5%;">S. No.</th>
                <th align="center" style="width:28%;">Description</th>
                <th align="center" style="width:6%;">UOM</th>
                <th align="center" style="width:9%;">Quantity</th>
                <th align="center" style="width:11%;">Rate ${record.currency}</th>
                <th align="center" style="width:11%;">Total ${record.currency}</th>
                <th align="center" style="width:8%;">VAT %</th>
                <th align="center" style="width:10%;">5% VAT ${record.currency}</th>
                <th align="center" style="width:12%;">Net Total ${record.currency}</th>
            </tr>
        </thead>
        <#list itemBatch as item>
         <tr>
            <td align="center">${sn}</td>
            <#assign sn = sn + 1 />
            <td align="left" style="white-space: normal; word-wrap: break-word;">${item.description}</td>
            <td align="center">${item.units}</td>
            <td align="right">${item.quantity?string("0.00")}</td>
            <td align="right">${item.rate?string("#,##0.00")}</td>
            <td align="right">${item.amount?string("#,##0.00")}</td>
            <td align="center">${item.taxrate1}</td>
            <td align="right">${item.tax1amt?string("#,##0.00")}</td>
            <td align="right">${item.grossamt?string("#,##0.00")}</td>
        </tr>
        <tr>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
        </tr>
        </#list>
        
        <#if batchIndex == 0>
            <#assign rowCount = itemBatch?size>
            <#assign maxRows = 5>
            <#if rowCount < maxRows>
                <#list 1..(maxRows - rowCount) as i>
                    <tr>
                        <td>&nbsp;</td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                    </tr>
                </#list>
            </#if>
        </#if>
        
        <#if !itemBatch?has_next>
        <!-- TOTAL LINE -->
         <tr class="total-row">
            <td colspan="5" align="left">Total</td>
            <td align="right" style="border-bottom:none;">${record.subtotal?string("#,##0.00")}</td>
            <td style="border-bottom:none;"></td>
            <td align="right" style="border-bottom:none;">${record.taxtotal?string("#,##0.00")}</td>
            <td align="right" style="border-bottom:none;">${record.total?string("#,##0.00")}</td>
        </tr>
        <#else>
        <!-- Bottom border for intermediate pages -->
        <tr>
            <td colspan="9" style="border-top: 0.1pt solid black; height: 1px; padding: 0;"></td>
        </tr>
        </#if>
    </table>

    <!-- SUMMARY SECTION - MOVED FROM FOOTER (REPEATS ON EVERY PAGE) -->
        <table style="width:100%; font-size:10px;" cellpadding="0" cellspacing="0">
            <tr>
               <!-- LEFT: AMOUNT IN WORDS & BANK DETAILS -->
                <td style="width:30%; vertical-align:top; font-size:12px; padding: 0px;margin-top:-10px;">
                    
                    <!-- Amount in Words -->
                    <div style="width:80%; font-size:12px; margin-top: 0px; margin-bottom:10px;">
                        <b>Amount in Words:</b><br/>
                        <b>${record.currency} </b><#if customData?? && customData.totalWords??>${customData.totalWords?upper_case}</#if> ONLY
                    </div>

                    <#if record.subsidiary == "SJS Enersol LLC">
                    <table style="width:100%;">
                        <tr>
                            <td valign="top">
                                <strong>A/C Title:</strong> SJS Enersol LLC<br/>
                                <strong>A/C No:</strong> 100-234850-4<br/>
                                <strong>IBAN No:</strong> AE93 0230 0000 0100 2348 504<br/>
                                <strong>Bank Name:</strong> Commercial Bank of Dubai<br/>
                                <strong>Bank Swift Code:</strong> CBDUAEADXXX<br/>
                                <strong>A/C Currency:</strong> ${record.currency}
                            </td>
                        </tr>
                    </table>
                    <#else>
                    <table style="width:100%;">
                        <tr>
                            <td valign="top">
                                <strong>A/C Title:</strong> SJS Enersol Engineering Works LLC<br/>
                                <strong>A/C No:</strong> 116-535379200-01<br/>
                                <strong>IBAN No:</strong> AE28 0030 0116 5353 7920 001<br/>
                                <strong>Bank Name:</strong> Abu Dhabi Commercial Bank<br/>
                                <strong>Bank Swift Code:</strong> ADCBAEAA<br/>
                                <strong>A/C Currency:</strong> ${record.currency}
                            </td>
                        </tr>
                    </table>
                    </#if>
                </td>
               <!-- RIGHT SUMMARY TABLE & STAMP -->
                <td style="width:30%; vertical-align:top; padding: 0px;">
                    <table class="summary-table" cellspacing="0" style="width: 100%; margin-top: 8px;">
                        <tr>
                            <td style="font-weight:bold;">Discount Amt</td>
                            <td align="right">${record.discounttotal?string("#,##0.00")}</td>
                        </tr>
                        <tr>
                            <td style="font-weight:bold;">Gross Amount</td>
                            <td align="right">${record.subtotal?string("#,##0.00")}</td>
                        </tr>
                        <tr>
                            <td style="font-weight:bold;">VAT</td>
                            <td align="right">${record.taxtotal?string("#,##0.00")}</td>
                        </tr>
                        <tr style="background-color: #f2f2f2; border-top: 0.5pt solid black;">
                            <td style="font-weight:bold;">Net Total:</td>
                            <td align="right" style="font-weight:bold;">
                                ${record.total?string("#,##0.00")}
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
            <tr>
                <td colspan="2" align="center" style="padding: 0px;">
                    <div style="margin-top: -90px;">
                        <#if record.subsidiary == "SJS Enersol LLC">
                            <img src="https://12075805.app.netsuite.com/core/media/media.nl?id=2612&amp;c=12075805&amp;h=aSxLVjuxt-21ptRX30lX5_2a8i13hkkFj8WSvkLOb9dlYyGE" style="width: 150px; height: 100px;"/>
                        <#else>
                            <img src="https://12075805.app.netsuite.com/core/media/media.nl?id=1341&amp;c=12075805&amp;h=p6n_1j8Du-e12Nvqgxvj2CNQf9B1_hxXyQ14-EmkGkEMEBwU" style="width: 100px; height: 100px;"/>
                        </#if>
                    </div>
                </td>
            </tr>
        </table>

    <#if itemBatch?has_next>
        <!-- Page Break if more chunks exist -->
        <pbr />
    </#if>
    <#assign batchIndex = batchIndex + 1 />
</#list>
</body>
</pdf>
