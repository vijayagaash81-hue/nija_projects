<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE pdf PUBLIC "-//big.faceless.org//report" "report-1.1.dtd">
<pdf>
<head>
    <style type="text/css">
        body {
            font-family: "Times New Roman", serif;
            font-size: 8.5pt;
        }
        table {
            width: 100%;
            border-collapse: collapse;
        }
        td, th {
            padding: 4px;
        }
            /* Main Item Table */
            .item-table {
                border: 0.1pt solid #000000;
            }
            .item-table th {
                border: 0.1pt solid #000000;
            }
            .item-table td {
                border-left: 0.1pt solid #000000;
                border-right: 0.1pt solid #000000;
                border-top: none;
                border-bottom: none;
            }
            .total-row td {
                border-top: 0.1pt solid #000000;
                border-bottom: 0.1pt solid #000000;
            }
        /* Style for specific tables with NO borders */
        .no-border td, .no-border th {
            border: none;
            padding: 2px;
        }
        .bold {
            font-weight: bold;
        }
        /* Summary table: Boxed outer border only, no internal tr borders */
        .summary-box {
            border: 0.8pt solid #000000;
        }
        .summary-box td {
            border: none;
            padding: 3px;
        }
        /* Vertical line divider for summary table if needed, otherwise clean */
        .summary-label {
            width: 60%;
            font-weight: bold;
        }
        .summary-value {
            width: 40%;
            text-align: right;
        }
        /* Header table: no borders and centered for the logo */
        .header-table, .header-table td {
            border: none;
            padding: 0;
            text-align: center;
        }
    </style>

    <!-- HEADER AND FOOTER MACRO DEFINITION -->
    <macrolist>
        <macro id="nlheader">
            <table class="header-table">
                <tr>
                    <td align="center" style="vertical-align: middle;">
                        <#if record.subsidiary == "SJS Enersol LLC">
                            <img src="https://12075805.app.netsuite.com/core/media/media.nl?id=2609&amp;c=12075805&amp;h=O64SxlG4LsWpTQ7LCnBKMcYi6jP9FLl-CoauR7s9agUSaA-D" style="width: 740px; height: 160px;padding-top:-100px;" />
                        <#else>
                            <img src="https://12075805.app.netsuite.com/core/media/media.nl?id=2619&amp;c=12075805&amp;h=lASWwe_0oZq1SqApNwf7Jqg-8vu504mSGH7thyIidSx1320v" style="width:650px;height:90px; padding-top:-40px;padding-left:0px;" />
                        </#if>
                    </td>
                </tr>
            </table>
        </macro>

        <macro id="nlfooter">
            <#if record.subsidiary == "SJS Enersol LLC">
                <table class="no-border" style="width: 100%; margin-top: 10px;">
                    <tr>
                        <td style="width: 100%; text-align: center; vertical-align: top; padding-left:50px;padding-top:10px;">
                             <img src="https://12075805.app.netsuite.com/core/media/media.nl?id=2610&amp;c=12075805&amp;h=XRONrANM19yECUoemjt7hHesM43YYYJpoDKZiz3h5ZvaZA1P" style="width: 580px; height: 55px;"/>
                        </td>
                    </tr>
                </table>
            <#else>
                <table class="no-border" style="width: 100%; margin-top: 10px;">
                    <tr>
                        <td style="width: 45%; vertical-align: bottom;">
                            <span style="color: #2e5190; font-weight: bold; font-size: 11px;">Name and Mobile Number:</span><br/>
                            <span style="color: #2e5190; font-weight: bold; font-size: 11px;">Receiver's Signature: ...........................................................</span>
                        </td>
                        <td style="width: 25%; text-align: center; vertical-align: top;">
                            <img src="https://12075805.app.netsuite.com/core/media/media.nl?id=1342&amp;c=12075805&amp;h=4Vq24cWx1KqWiN1XiHtzzTYH7-sQ2imkhln23ZDCxBNi0hDM" style="width: 180px; height: 35px;"/>
                        </td>
                        <td style="width: 30%; text-align: right; vertical-align: bottom;">
                            <span style="color: #2e5190; font-weight: bold; font-size: 12px;">For SJS Enersol Engineering Works L.L.C.</span>
                        </td>
                    </tr>
                </table>
               
                <table class="no-border" style="width: 100%; background-color: #2e5190; margin-top: 5px;">
                    <tr>
                        <td align="center" style="color: #ffffff; font-weight: bold; font-size: 11pt; padding: 4px;">
                            Hex Bolt, Stud Bolt, Anchor Bolt And Heavy Engineering Construction
                        </td>
                    </tr>
                </table>
            </#if>
        </macro>
    </macrolist>
</head>

<body header="nlheader" header-height="80pt" footer="nlfooter" footer-height="95pt">

<!-- ================= TITLE ================= -->
<table class="no-border" style="width: 100%; margin-top: 0px;">
    <tr>
        <td align="center">
            <span style="font-size:16px; font-weight:bold; border-bottom:1.5pt solid #000; padding-bottom:2px;">
                Commercial Invoice
            </span>
        </td>
    </tr>
</table>

<!-- ================= HEADER INFO ================= -->
<table class="no-border" style="width: 100%; margin-top: 10px;">
    <tr>
        <td style="width: 65%; vertical-align: top;">
            <span style="font-size:9pt;"><strong>Consignee Name,</strong></span><br/>
            <span style="font-size:9pt;">
                <#if record.entity.companyname?has_content>
                    <strong>${record.entity.companyname}</strong>
                <#elseif record.entity.firstname?has_content>
                    <strong>${record.entity.firstname} ${record.entity.lastname}</strong>
                <#else>
                    <strong>${record.entity}</strong>
                </#if>
            </span><br/>
            <#assign cleanedAddress = record.billaddress>
            <#if record.entity.companyname?has_content>
                <#assign cleanedAddress = cleanedAddress?replace(record.entity.companyname, "")?trim>
            <#elseif record.entity.firstname?has_content>
                <#assign cleanedAddress = cleanedAddress?replace(record.entity.firstname + " " + record.entity.lastname, "")?trim>
            </#if>
            
            <#if cleanedAddress?starts_with("<br>")><#assign cleanedAddress = cleanedAddress?substring(4)?trim>
            <#elseif cleanedAddress?starts_with("<br/>")><#assign cleanedAddress = cleanedAddress?substring(5)?trim>
            <#elseif cleanedAddress?starts_with("<br />")><#assign cleanedAddress = cleanedAddress?substring(6)?trim>
            </#if>
            <span>${cleanedAddress}</span><br/>
            <strong>TRN:</strong> ${record.vatregnum}<br/>
            <strong>Tel:</strong> ${record.entity.phone} &nbsp; <strong>Fax:</strong> ${record.entity.fax}
        </td>
        <td style="width: 35%; vertical-align: top;">
            <table class="no-border" style="width: 100%;">
                <tr>
                    <td class="bold" style="width: 40%;">Date</td>
                    <td>: ${record.trandate}</td>
                </tr>
                <tr>
                    <td class="bold">C.I No</td>
                    <td>: ${record.tranid}</td>
                </tr>
                <tr>
                    <td class="bold">D.O No:</td>
                    <td>:
                    ${record.custbodycustbody_do_number}</td> <!-- Update with your actual internal ID -->
                </tr>
                <tr>
                    <td class="bold" style="white-space: nowrap;">Order No</td>
                    <td style="white-space: nowrap;">: ${record.otherrefnum}</td>
                </tr>
                <tr>
                    <td class="bold" style="white-space:nowrap;">P.I. No:</td>
                    <td style="white-space:nowrap;">: ${record.createdfrom}</td>
                </tr>
            </table>
        </td>
    </tr>
</table>

<br/>

<!-- ================= ITEM TABLE ================= -->
<table class="item-table" cellspacing="0" style="width:100%; font-size:8pt; margin-top: 5px;">
    <thead>
        <tr style="background-color: #f2f2f2; font-weight:bold;">
            <th align="center" style="width:4%;">S. No.</th>
            <th align="left" style="width:9%;">HS Code</th>
            <th align="left" style="width:23%;">Description</th>
            <th align="center" style="width:5%;">UOM</th>
            <th align="right" style="width:7%;">Qty</th>
            <th align="right" style="width:9%;">Rate<br/>AED</th>
            <th align="right" style="width:11%;">Net Total<br/>AED</th>
            <th align="center" style="width:11%;">Net Weight<br/>in Kgs</th>
            <th align="center" style="width:11%;">Gross Weight<br/>in Kgs</th>
            <th align="center" style="width:10%;">Origin</th>
        </tr>
    </thead>
    <!-- FILTER OUT ITEMS WHERE AMOUNT IS ZERO -->
    <#assign filteredItems = [] />
    <#list record.item as rawItem>
        <#if rawItem.amount?has_content && rawItem.amount != 0>
            <#assign filteredItems = filteredItems + [rawItem] />
        <#elseif !rawItem.amount?has_content>
            <#assign filteredItems = filteredItems + [rawItem] />
        </#if>
    </#list>

    <#assign totalCalcGrossWeight = 0>
    <#list filteredItems as item>
    <#assign lineGrossWeight = 0>
    <#if item.quantity?has_content && item.custcol_weight_kgs?has_content>
        <#assign lineGrossWeight = item.quantity * item.custcol_weight_kgs>
        <#assign totalCalcGrossWeight = totalCalcGrossWeight + lineGrossWeight>
    </#if>
    <tr>
        <td align="center">${item_index + 1}</td>
        <td>${item.item.upccode}</td>
        <td>${item.description}</td>
        <td align="center">${item.units}</td>
        <td align="right"><#if item.quantity?has_content>${item.quantity?string("#,##0.00")}</#if></td>
        <td align="right"><#if item.rate?has_content>${item.rate?string("#,##0.00")}</#if></td>
        <td align="right"><#if item.amount?has_content>${item.amount?string("#,##0.00")}</#if></td>
        <td align="center"><#if item.custcol1?has_content>${item.custcol1}</#if></td>
        <td align="center"><#if item.custcol1?has_content> ${(item.custcol1 * item.quantity)}</#if></td>
        <td align="center">${item.item.custitem_njt_ctry_org}</td>
    </tr>
    </#list>
    
    <#assign rowCount = filteredItems?size>
    <#assign maxRows = 10>
    <#if rowCount < maxRows>
        <#list 1..(maxRows - rowCount) as i>
        <tr>
            <td>&nbsp;</td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
            <td></td>
        </tr>
        </#list>
    </#if>
    
    <!-- Total Summary Row at bottom of table -->
    <tr class="total-row" style="font-weight:bold; background-color: #f2f2f2;">
        <td colspan="4">Total</td>
        <td align="right"><#if record.totalquantity?has_content>${record.totalquantity?string("#,##0.00")}</#if></td>
        <td>&nbsp;</td>
        <td align="right"><#if record.subtotal?has_content>${record.subtotal?string("#,##0.00")}</#if></td>
        <td align="center"><#if record.custbody_total_weight?has_content>${record.custbody_total_weight?string("#,##0.00")}</#if></td>
        <td align="center"><#if totalCalcGrossWeight != 0>${totalCalcGrossWeight?string("#,##0.00")}<#elseif record.custbody_total_gross_weight?has_content>${record.custbody_total_gross_weight?string("#,##0.00")}</#if></td>
        <td>&nbsp;</td>
    </tr>
</table>

<!-- ================= FOOTER SUMMARY & STAMP ================= -->
<table class="no-border" style="width:100%; font-size: 8.5pt; margin-top: 0px;" cellpadding="0" cellspacing="0">
    <tr>
        <!-- LEFT: Amount in words & Shipment Details -->
        <td style="width:45%; vertical-align:top; padding: 0px;">
            <!-- Amount in Words -->
            <div style="margin-top: 0px; margin-bottom:10px;">
                <strong>AED &nbsp; ${record.custbody_njt_tran_tiw} ONLY</strong>
            </div>
            <!-- Shipment Details Mapping -->
            <div style="font-size: 7.5pt; color: #333; margin-top: 5px;">
                Weight : <#if record.custbody_total_weight?has_content>${record.custbody_total_weight?string("#,##0.00")}</#if> Ton , Packing : 1 Pallet , HS Code : <#if filteredItems?has_content>${filteredItems[0].item.upccode}</#if> , Origin : <#if filteredItems?has_content>${filteredItems[0].item.custitem_njt_ctry_org}</#if> , Mode of Transport : By Road
            </div>
        </td>

        <!-- CENTER: Stamp Image -->
        <td style="width:25%; text-align:center; vertical-align:top;">
            <div style="margin-top: 50px;">
                <#if record.subsidiary == "SJS Enersol LLC">
                    <img src="https://12075805.app.netsuite.com/core/media/media.nl?id=2612&amp;c=12075805&amp;h=aSxLVjuxt-21ptRX30lX5_2a8i13hkkFj8WSvkLOb9dlYyGE" style="width: 150px; height: 100px;"/>
                <#else>
                    <img src="https://12075805.app.netsuite.com/core/media/media.nl?id=1341&amp;c=12075805&amp;h=p6n_1j8Du-e12Nvqgxvj2CNQf9B1_hxXyQ14-EmkGkEMEBwU" style="width: 100px; height: 100px;"/>
                </#if>
            </div>
        </td>

        <!-- RIGHT: Summary Box (No internal row borders) -->
        <td style="width:30%; vertical-align:top; padding: 0px;">
            <table class="summary-box" cellspacing="0" style="width: 100%; margin-top: 4px;">
                <tr>
                    <td class="summary-label">Discount Amt</td>
                    <td class="summary-value" align="right"><#if record.discounttotal?has_content>${record.discounttotal?string("#,##0.00")}</#if></td>
                </tr>
                <tr>
                    <td class="summary-label">Gross Amount</td>
                    <td class="summary-value" align="right"><#if record.subtotal?has_content>${record.subtotal?string("#,##0.00")}</#if></td>
                </tr>
                <tr>
                    <td class="summary-label" style="border-bottom: 0.5pt solid black;">VAT</td>
                    <td class="summary-value" align="right" style="border-bottom: 0.5pt solid black;"><#if record.taxtotal?has_content>${record.taxtotal?string("#,##0.00")}</#if></td>
                </tr>
                <tr style="background-color: #f2f2f2;">
                    <td class="summary-label" style="font-size: 9.5pt;">Net Total:</td>
                    <td class="summary-value" align="right" style="font-size: 9.5pt; font-weight: bold;"><#if record.total?has_content>${record.total?string("#,##0.00")}</#if></td>
                </tr>
            </table>
        </td>
    </tr>
</table>

</body>
</pdf>