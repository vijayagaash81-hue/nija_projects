<style>
/* Base */
html, body {
	font-family: Helvetica, Arial, sans-serif;
	font-size: 9pt;
	color: #000;
}

/* Header */
.header {
	width: 100%;
	border-top: 6px solid #2E75B6; /* blue top bar like the image */
	padding-top: 8px;
}
.header-table {
	width: 100%;
	border-collapse: collapse;
}
.logo-cell {
	width: 18%;
	vertical-align: top;
}
.company-cell {
	width: 62%;
	text-align: center;
	vertical-align: top;
}
.meta-cell {
	width: 20%;
	text-align: right;
	vertical-align: top;
}
.company-name {
	font-size: 14pt;
	font-weight: bold;
	color: #1f4e79;
}
.company-contact {
	font-size: 8.5pt;
	color: #333;
	margin-top: 4px;
}

/* Title area */
.doc-title {
	margin-top: 8px;
	background-color: #2E75B6;
	color: white;
	padding: 6px 10px;
	font-weight: bold;
	text-align: left;
	font-size: 12pt;
}

/* Info block */
.info-table {
	width: 100%;
	margin-top: 8px;
	border-collapse: collapse;
}
.info-table td {
	padding: 3px 6px;
	vertical-align: top;
}

/* Transactions table */
.tran-table {
	width: 100%;
	border-collapse: collapse;
	margin-top: 10px;
	font-size: 8.5pt;
}
.tran-table th {
	background-color: #D9E7F9;
	color: #083B66;
	padding: 6px;
	border: 1px solid #9BB7DD;
	text-align: left;
	font-weight: bold;
}
.tran-table td {
	padding: 6px;
	border: 1px solid #D1DCEB;
}
.tran-table .right {
	text-align: right;
}

/* Summary */
.summary-block {
	margin-top: 12px;
}
.summary-table {
	width: 360px;
	float: right;
	border-collapse: collapse;
}
.summary-table td {
	border: 1px solid #D1DCEB;
	padding: 6px;
}
.summary-table .label {
	background-color: #D9E7F9;
	font-weight: bold;
	color: #083B66;
}

/* Footer */
.footer {
	margin-top: 30px;
	font-size: 8pt;
	color: #555;
}

/* Misc */
.small { font-size: 8pt; color: #666; }
.page-break { page-break-after: always; }
</style>
</head>
