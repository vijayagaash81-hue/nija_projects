<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE pdf PUBLIC "-//big.faceless.org//report" "report-1.1.dtd">
<pdf>
    <head>
        <link name="NotoSans" type="font" subtype="truetype" src="\${nsfont.NotoSans_Regular}" src-bold="\${nsfont.NotoSans_Bold}" src-italic="\${nsfont.NotoSans_Italic}" />
        <style type="text/css">
            * {
                font-family: NotoSans, sans-serif;
                font-size: 9pt;
            }
            body {
                padding: 0;
                margin: 0;
                color: #1e293b;
            }
            table {
                width: 100%;
                border-collapse: collapse;
                table-layout: fixed;
            }
            .header-banner {
                background-color: #0f172a;
                color: #ffffff;
                padding: 12px 18px;
                border-radius: 4px;
            }
            .company-name {
                font-size: 16pt;
                font-weight: bold;
                letter-spacing: 0.5px;
            }
            .doc-type-badge {
                font-size: 14pt;
                font-weight: bold;
                color: #38bdf8;
                text-align: right;
            }
            .meta-table {
                margin-top: 15px;
                border: 0.5px solid #cbd5e1;
                background-color: #f8fafc;
            }
            .meta-table td {
                padding: 6px 10px;
                border: 0.5px solid #e2e8f0;
            }
            .meta-label {
                font-weight: bold;
                color: #475569;
                background-color: #f1f5f9;
            }
            .item-table {
                margin-top: 20px;
                border: 1px solid #cbd5e1;
            }
            .item-table th {
                background-color: #0284c7;
                color: #ffffff;
                font-weight: bold;
                padding: 8px 6px;
                text-align: left;
                font-size: 8.5pt;
            }
            .item-table td {
                padding: 7px 6px;
                border-bottom: 0.5px solid #e2e8f0;
                font-size: 8.5pt;
            }
            .item-table tr.alt-row td {
                background-color: #f8fafc;
            }
            .text-right {
                text-align: right;
            }
            .text-center {
                text-align: center;
            }
            .total-table {
                margin-top: 12px;
                width: 45%;
                margin-left: 55%;
                border: 1px solid #cbd5e1;
            }
            .total-table td {
                padding: 5px 8px;
            }
            .total-grand {
                font-size: 10.5pt;
                font-weight: bold;
                background-color: #e0f2fe;
                color: #0369a1;
                border-top: 2px solid #0284c7;
            }
            .terms-box {
                margin-top: 20px;
                padding: 10px;
                border: 1px dashed #cbd5e1;
                background-color: #fafafa;
                font-size: 8pt;
                color: #64748b;
            }
            .signature-table {
                margin-top: 35px;
            }
            .sig-line {
                border-top: 1px solid #334155;
                margin-top: 45px;
                padding-top: 5px;
                text-align: center;
                font-weight: bold;
            }
            .page-footer-text {
                font-size: 7.5pt;
                color: #94a3b8;
            }
        </style>
        <macrolist>
            <macro id="docFooter">
                <table width="100%">
                    <tr>
                        <td width="40%" class="page-footer-text">
                            Confidential | Generated by NetSuite ERP System
                        </td>
                        <td width="30%" class="page-footer-text" align="center">
                            Printed: \${custom.printDate} \${custom.printTime}
                        </td>
                        <td width="30%" class="page-footer-text" align="right">
                            Page <pagenumber/> of <totalpages/>
                        </td>
                    </tr>
                </table>
            </macro>
        </macrolist>
    </head>
    <body footer="docFooter" footer-height="20pt">
        <!-- HEADER SECTION -->
        <table class="header-banner">
            <tr>
                <td width="60%">
                    <div class="company-name">\${custom.companyName}</div>
                    <div style="font-size: 8.5pt; color: #cbd5e1; margin-top: 4px;">\${custom.companyAddress}</div>
                    <div style="font-size: 8.5pt; color: #38bdf8;">\${custom.companyTaxId}</div>
                </td>
                <td width="40%">
                    <div class="doc-type-badge">COMMERCIAL INVOICE</div>
                    <div style="text-align: right; color: #e2e8f0; font-size: 9pt; margin-top: 4px;">
                        <b>Doc Ref:</b> \${record.tranid!record.name!"REF-PENDING"}<br/>
                        <b>Date:</b> \${record.trandate!custom.printDate}
                    </div>
                </td>
            </tr>
        </table>

        <!-- METADATA INFORMATION GRID -->
        <table class="meta-table">
            <tr>
                <td width="20%" class="meta-label">Customer / Party</td>
                <td width="30%">\${record.entity}</td>
                <td width="20%" class="meta-label">Payment Terms</td>
                <td width="30%">\${record.terms!"Net 30 Days"}</td>
            </tr>
            <tr>
                <td class="meta-label">Subsidiary</td>
                <td>\${record.subsidiary}</td>
                <td class="meta-label">Due Date</td>
                <td>\${record.duedate!custom.printDate}</td>
            </tr>
            <tr>
                <td class="meta-label">Department / Project</td>
                <td>\${record.department!"Commercial Operations"}</td>
                <td class="meta-label">Currency</td>
                <td>\${record.currencysymbol!"AED"}</td>
            </tr>
        </table>

        <!-- TRANSACTION SUBLIST ITEMS -->
        <table class="item-table">
            <thead>
                <tr>
                    <th width="6%" class="text-center">#</th>
                    <th width="18%">Item Code</th>
                    <th width="36%">Description</th>
                    <th width="10%" class="text-center">Qty</th>
                    <th width="15%" class="text-right">Unit Rate</th>
                    <th width="15%" class="text-right">Total Amount</th>
                </tr>
            </thead>
            <tbody>
                <#if record.item?has_content>
                    <#list record.item as item>
                    <tr class="\${(item_index % 2 == 1)?then('alt-row', '')}">
                        <td class="text-center">\${item_index + 1}</td>
                        <td><b>\${item.item}</b></td>
                        <td>\${item.description!"--"}</td>
                        <td class="text-center">\${item.quantity}</td>
                        <td class="text-right">\${item.rate?string(",##0.00")}</td>
                        <td class="text-right">\${item.amount?string(",##0.00")}</td>
                    </tr>
                    </#list>
                <#else>
                    <tr>
                        <td colspan="6" class="text-center" style="padding: 15px; color: #94a3b8;">
                            No transaction lines available.
                        </td>
                    </tr>
                </#if>
            </tbody>
        </table>

        <!-- SUMMARY TOTALS -->
        <table class="total-table">
            <tr>
                <td width="60%"><b>Subtotal:</b></td>
                <td width="40%" class="text-right">\${record.subtotal!record.total!"0.00"}</td>
            </tr>
            <#if record.taxtotal?has_content>
            <tr>
                <td><b>VAT / Tax (5%):</b></td>
                <td class="text-right">\${record.taxtotal}</td>
            </tr>
            </#if>
            <tr class="total-grand">
                <td><b>Grand Total (\${record.currencysymbol!"AED"}):</b></td>
                <td class="text-right"><b>\${record.total!"0.00"}</b></td>
            </tr>
        </table>

        <!-- TERMS & REMARKS -->
        <div class="terms-box">
            <b>Terms &amp; Conditions:</b><br/>
            1. All goods remain the property of \${custom.companyName} until fully settled.<br/>
            2. Inquiries regarding this invoice should be submitted within 7 working days from the invoice date.<br/>
            3. Thank you for your business!
        </div>

        <!-- DUAL SIGNATURE BLOCK -->
        <table class="signature-table">
            <tr>
                <td width="40%">
                    <div class="sig-line">Prepared &amp; Verified By</div>
                </td>
                <td width="20%"></td>
                <td width="40%">
                    <div class="sig-line">Authorized Signatory &amp; Stamp</div>
                </td>
            </tr>
        </table>
    </body>
</pdf>
