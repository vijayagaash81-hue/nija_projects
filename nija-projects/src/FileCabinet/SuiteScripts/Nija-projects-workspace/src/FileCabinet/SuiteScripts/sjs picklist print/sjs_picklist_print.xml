<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE pdf PUBLIC "-//big.faceless.org//report" "report-1.1.dtd">
<pdf>
<head>
    <style type="text/css">
        body {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 8.5pt;
            color: #000000;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        .no-border, .no-border td {
            border: none;
        }

        /* Header Macro Table */
        .header-table, .header-table td {
            border: none;
            padding: 0;
            text-align: center;
        }

        /* Title styling */
        .doc-title {
            text-align: center;
            font-size: 15pt;
            font-weight: bold;
            font-family: Arial, Helvetica, sans-serif;
            margin-top: 2px;
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        /* Bordered Box Tables for Top Info Header - Ultra Thin 0.1pt Borders */
        .info-box {
            border-collapse: collapse;
            border: 0.1pt solid #000000;
            width: 100%;
        }

        .info-box td {
            border: 0.1pt solid #000000;
            padding: 3px 5px;
            font-size: 8pt;
            vertical-align: middle;
        }

        .info-box td.label {
            font-weight: bold;
            background-color: #ffffff;
            white-space: nowrap;
        }

        .info-box td.value {
            font-weight: bold;
            text-align: center;
        }

        /* Main Pick List Item Table - Thin Hairline 0.1pt Borders */
        .item-table {
            width: 100%;
            border-collapse: collapse;
            border: 0.1pt solid #000000;
            margin-top: 8px;
            table-layout: fixed;
        }

        .item-table th {
            border: 0.1pt solid #000000;
            padding: 4px 2px;
            font-size: 8pt;
            background-color: #ffffff;
            font-weight: bold;
            text-align: center;
            vertical-align: middle;
        }

        .item-table td {
            border: 0.1pt solid #000000;
            padding: 3px 2px;
            font-size: 8pt;
            height: 20px;
            vertical-align: middle;
        }

        .center { text-align: center; }
        .right { text-align: right; }
        .left { text-align: left; }
        .bold { font-weight: bold; }

    </style>

    <!-- HEADER AND FOOTER MACRO DEFINITIONS -->
    <macrolist>
        <macro id="nlheader">
            <table class="header-table">
                <tr>
                    <td align="center" style="vertical-align: middle;">
                        <#if record.subsidiary?has_content && (record.subsidiary == "SJS Enersol LLC" || record.subsidiary?contains("SJS Enersol LLC"))>
                            <img src="https://12075805.app.netsuite.com/core/media/media.nl?id=2609&amp;c=12075805&amp;h=O64SxlG4LsWpTQ7LCnBKMcYi6jP9FLl-CoauR7s9agUSaA-D" style="width: 740px; height: 160px; padding-top: -60px;" />
                        <#else>
                            <img src="https://12075805.app.netsuite.com/core/media/media.nl?id=2619&amp;c=12075805&amp;h=lASWwe_0oZq1SqApNwf7Jqg-8vu504mSGH7thyIidSx1320v" style="width: 600px; height: 90px; padding-top: -40px;" />
                        </#if>
                    </td>
                </tr>
            </table>
        </macro>

        <macro id="nlfooter">
            <#if record.subsidiary?has_content && (record.subsidiary == "SJS Enersol LLC" || record.subsidiary?contains("SJS Enersol LLC"))>
                <table class="no-border" style="width: 100%; margin-top: 5px;">
                    <tr>
                        <td style="width: 100%; text-align: center; vertical-align: top; padding-left: 170px; padding-top: 5px;">
                             <img src="https://12075805.app.netsuite.com/core/media/media.nl?id=2610&amp;c=12075805&amp;h=XRONrANM19yECUoemjt7hHesM43YYYJpoDKZiz3h5ZvaZA1P" style="width: 580px; height: 55px;"/>
                        </td>
                    </tr>
                </table>
            <#else>
                <table class="no-border" style="width: 100%;">
                    <tr>
                        <td style="width: 50%; vertical-align: bottom;">
                            <span style="color: #2e5190; font-weight: bold; font-size: 8.5pt;">Name and Mobile Number:</span><br/>
                            <span style="color: #2e5190; font-weight: bold; font-size: 8.5pt; white-space: nowrap;">Receiver's Signature: .....................................................</span>
                        </td>
                        <td style="width: 20%; text-align: center; vertical-align: top;">
                            <img src="https://12075805.app.netsuite.com/core/media/media.nl?id=1342&amp;c=12075805&amp;h=4Vq24cWx1KqWiN1XiHtzzTYH7-sQ2imkhln23ZDCxBNi0hDM" style="width: 160px; height: 30px;"/>
                        </td>
                        <td style="width: 30%; text-align: right; vertical-align: bottom;">
                            <span style="color: #2e5190; font-weight: bold; font-size: 9.5pt;">For SJS Enersol Engineering Works L.L.C.</span>
                        </td>
                    </tr>
                </table>
                <table class="no-border" style="width: 100%; background-color: #2e5190; margin-top: 3px;">
                    <tr>
                        <td align="center" style="color: #ffffff; font-weight: bold; font-size: 8.5pt; padding: 3px;">
                            Hex Bolt, Stud Bolt, Anchor Bolt And Heavy Engineering Construction
                        </td>
                    </tr>
                </table>
            </#if>
            <table class="no-border" style="width: 100%; margin-top: 3px;">
                <tr>
                    <td align="right" style="font-size: 8pt;">
                        Page <pagenumber/> of <totalpages/>
                    </td>
                </tr>
            </table>
        </macro>
    </macrolist>
</head>

<body header="nlheader" header-height="95pt" footer="nlfooter" footer-height="65pt" padding="0.4in" size="A4-landscape">

<#assign itemList = (record.item)![] />
<#list itemList?chunk(10) as itemBatch>

    <!-- DOCUMENT TITLE -->
    <div class="doc-title">WORK ORDER</div>

    <!-- TOP HEADER DATA BOXES -->
    <table class="no-border" style="width: 100%; margin-bottom: 8px;">
        <tr>
            <!-- W.O #, Company, S.O Date, S.O No. BOX -->
            <td style="width: 45%; vertical-align: top;">
                <table class="info-box">
                    <tr>
                        <td class="label">Delivery point</td>
                        <td class="value">
                    
                                ${record.custbody_delivery_point}
                 
                        </td>
                    </tr>
                    <tr>
                        <td class="label">S.O Date</td>
                        <td class="value">
                            <#if record.trandate?has_content>
                                ${record.trandate}
                            <#elseif record.custbody_sjs_po_date?has_content>
                                ${record.custbody_sjs_po_date}
                            <#elseif record.otherrefdate?has_content>
                                ${record.otherrefdate}
                            <#else>
                                -
                            </#if>
                        </td>
                    </tr>
                    <tr>
                        <td class="label">S.O No.</td>
                        <td class="value">
                            <#if record.tranid?has_content>
                                ${record.tranid}
                            <#elseif record.otherrefnum?has_content>
                                ${record.otherrefnum}
                            <#elseif record.custbody_njt_item_po?has_content>
                                ${record.custbody_njt_item_po}
                            <#else>
                                -
                            </#if>
                        </td>
                    </tr>
                    <tr>
                        <td class="label">PO #</td>
                        <td class="value">
                            <#if record.custbody_njt_item_po?has_content>
                                ${record.custbody_njt_item_po}
                            <#elseif record.otherrefnum?has_content>
                                ${record.otherrefnum}
                            <#else>
                                -
                            </#if>
                        </td>
                    </tr>
                </table>
            </td>
            <td style="width: 55%;"></td>
        </tr>
    </table>

    <!-- MAIN ITEM TABLE (10 LINES MAX PER PAGE) -->
    <table class="item-table" cellspacing="0">
        <thead>
            <tr>
                <th style="width: 5.5%; white-space: nowrap;">Sr. No.</th>
                <th style="width: 34.5%;">Particulars</th>
                <th style="width: 6%;">UOM</th>
                <th style="width: 8%;">Coating</th>
                <th style="width: 5%;">Qty.</th>
                <th style="width: 9%; white-space: nowrap;">Stock Avl.</th>
                <th style="width: 8%;">Bin Num. 1</th>
                <th style="width: 8%;">Bin Num. 2</th>
                <th style="width: 8%;">Bin Num. 3</th>
                <th style="width: 8%;">Bin Num. 4</th>
            </tr>
        </thead>
        <tbody>
            <#list itemBatch as item>
            <tr>
                <td class="center">${item_index + 1 + (itemBatch_index * 10)}</td>
                <td class="left" style="white-space: normal; word-wrap: break-word;">
                    <#if item.custcol_njt_podesc?has_content>
                        ${item.custcol_njt_podesc}
                    <#elseif item.description?has_content>
                        ${item.description}
                    <#else>
                        ${item.item}
                    </#if>
                </td>
                <td class="center">
                    <#if item.units?has_content>
                        ${item.units}
                    <#elseif item.units?has_content>
                        ${item.units}
                    <#else>
                        
                    </#if>
                </td>
                <td class="center">
                    <#if item.custcol_sjs_coating?has_content>
                        ${item.custcol_sjs_coating}
                    <#elseif item.custcol_coating?has_content>
                        ${item.custcol_coating}
                    <#else>
                        
                    </#if>
                </td>
                <td class="center">
                    <#if item.quantity?has_content>
                        ${item.quantity?string("0")}
                    <#elseif item.quantitycommitted?has_content>
                        ${item.quantitycommitted?string("0")}
                    <#else>
                        
                    </#if>
                </td>
                <td class="center">
                    <#if item.custcol_stock_available?has_content>
                        ${item.custcol_stock_available}
                    <#elseif item.quantityonhand?has_content>
                        ${item.quantityonhand}
                    <#else>
                        
                    </#if>
                </td>
                <td class="center">
                    <#if item.custcol_bin_num_1?has_content>
                        ${item.custcol_bin_num_1}
                    <#elseif item.binnumber?has_content>
                        ${item.binnumber}
                    <#else>
                        
                    </#if>
                </td>
                <td class="center">
                    <#if item.custcol_bin_num_2?has_content>
                        ${item.custcol_bin_num_2}
                    <#else>
                        
                    </#if>
                </td>
                <td class="center">
                    <#if item.custcol_supp_ref_1?has_content>
                        ${item.custcol_supp_ref_1}
                    <#elseif item.custcol_supp_ref?has_content>
                        ${item.custcol_supp_ref}
                    <#else>
                        
                    </#if>
                </td>
                <td class="center">
                    <#if item.custcol_supp_ref_2?has_content>
                        ${item.custcol_supp_ref_2}
                    <#else>
                        
                    </#if>
                </td>
            </tr>
            </#list>

            <!-- BLANK FILLER ROWS TO ENSURE ALWAYS 10 ROWS PER PAGE -->
            <#assign batchSize = itemBatch?size>
            <#if batchSize lt 10>
                <#list 1..(10 - batchSize) as i>
                <tr>
                    <td class="center">&nbsp;</td>
                    <td>&nbsp;</td>
                    <td>&nbsp;</td>
                    <td>&nbsp;</td>
                    <td>&nbsp;</td>
                    <td>&nbsp;</td>
                    <td>&nbsp;</td>
                    <td>&nbsp;</td>
                    <td>&nbsp;</td>
                   <td>&nbsp;</td>
                </tr>
                </#list>
            </#if>
        </tbody>
    </table>

    <#if itemBatch?has_next>
        <pbr />
    </#if>

</#list>

</body>
</pdf>
